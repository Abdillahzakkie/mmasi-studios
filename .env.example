# Copy to .env.local and fill in. The local defaults target the shared Docker
# services (see README).

# MongoDB connection string (dedicated database per project).
MONGODB_URI=mongodb://127.0.0.1:27018/mmasi

# Admin auth.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=hello@mmasiejikeme.studio
ADMIN_PASSWORD=change-me

# Object storage (S3-compatible; MinIO for local dev).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mmasi
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_ASSET_BASE=http://127.0.0.1:9000/mmasi
